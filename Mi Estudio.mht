@charset "utf-8";

:root { --bg: #F2DEC7; --pe: #E1B8A2; --ol: #6B6D43; --sa: #ABA66F; --te: #CF7D65; --az: #99B4AA; --tx: #3d3f22; }

* { box-sizing: border-box; }

body { margin: 0px; background: var(--bg); color: var(--tx); font: 15px / 1.4 system-ui, sans-serif; padding-bottom: 40px; }

header { position: sticky; top: 0px; background: var(--bg); padding: 10px 14px 6px; z-index: 5; }

h1 { margin: 0px; font-size: 20px; }

.r { display: flex; align-items: center; justify-content: space-between; gap: 8px; }

main { padding: 8px 14px; max-width: 640px; margin: auto; }

button { background: var(--ol); color: rgb(255, 255, 255); border: 0px; border-radius: 12px; padding: 10px 14px; font: inherit; cursor: pointer; }

button.sec { background: var(--bg); color: var(--ol); border: 1px solid var(--sa); }

button.dng { background: none; color: var(--te); border: 1px solid var(--te); width: 100%; margin-top: 8px; }

#tabs, #sub { display: flex; gap: 6px; overflow-x: auto; margin-top: 8px; }

.tb { background: var(--pe); color: var(--tx); white-space: nowrap; padding: 8px 12px; }

.tb.on { background: var(--c,var(--sa)); font-weight: 700; box-shadow: 0 3px 0 var(--ol); }

#sub .tb { background: none; border: 1px solid var(--sa); border-radius: 20px; }

#sub .tb.on { background: var(--ol); color: rgb(255, 255, 255); box-shadow: none; }

.card { background: var(--pe); border-radius: 16px; padding: 14px; margin-bottom: 12px; border-left: 5px solid var(--c,var(--ol)); }

.note { font-size: 13px; margin: 6px 0px; opacity: 0.85; }

small { opacity: 0.8; }

a { color: var(--ol); font-weight: 600; }

h3 { margin: 0px 0px 8px; font-size: 16px; }

.wk, .cg { display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; }

.wk { margin: 10px 0px 4px; text-align: center; font-size: 12px; }

.cg i { display: block; }

.cd { aspect-ratio: 1 / 1; border-radius: 12px; background: var(--bg); color: var(--tx); padding: 2px; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 14px; }

.cd small { font-size: 13px; min-height: 15px; opacity: 1; }

.cd.full { background: var(--ol); color: rgb(255, 255, 255); }

.cd.part { background: var(--sa); }

.cd.none { background: color-mix(in srgb,var(--te) 45%,var(--bg)); }

.cd.rest, .cd.rest0 { background: transparent; border: 1px dashed var(--sa); }

.cd.fut { opacity: 0.5; }

.cd.tod { outline: 2px solid var(--tx); }

.lg { display: flex; flex-wrap: wrap; gap: 8px; font-size: 12px; margin-top: 10px; }

.lg span { padding: 3px 8px; border-radius: 10px; background: var(--bg); }

.lg .full { background: var(--ol); color: rgb(255, 255, 255); }

.lg .part { background: var(--sa); }

.lg .none { background: color-mix(in srgb,var(--te) 45%,var(--bg)); }

.g2, .kg { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }

.kp { background: var(--bg); border-radius: 14px; padding: 10px; }

.kp b { font-size: 22px; display: block; color: var(--ol); }

.bar { height: 9px; background: var(--bg); border-radius: 8px; overflow: hidden; margin: 8px 0px; }

.bar i { display: block; height: 100%; background: var(--c,var(--ol)); transition: width 0.4s; }

.ch { display: flex; gap: 4px; align-items: flex-end; height: 110px; }

.cb { flex: 1 1 0%; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; }

.cb i { display: block; width: 100%; background: var(--ol); border-radius: 4px 4px 0px 0px; min-height: 2px; }

.cb small { font-size: 9px; }

.dy { padding: 8px 11px; background: var(--bg); color: var(--ol); margin: 2px; }

.dy.on { background: var(--ol); color: rgb(255, 255, 255); }

.st { display: flex; gap: 10px; align-items: center; padding: 8px 0px; border-top: 1px solid var(--bg); cursor: pointer; }

.ck { width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--ol); flex: 0 0 auto; display: flex; align-items: center; justify-content: center; color: rgb(255, 255, 255); }

.st.done .ck { background: var(--ol); }

.x { background: none; color: var(--ol); padding: 2px 8px; }

details { margin-top: 8px; }

summary { cursor: pointer; font-weight: 600; }

.q { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px; }

dialog { background: var(--bg); color: var(--tx); border: 2px solid var(--sa); border-radius: 18px; width: min(92vw, 460px); padding: 16px; max-height: 90vh; }

dialog::backdrop { background: rgba(0, 0, 0, 0.4); }

label { display: block; font-size: 12px; margin: 8px 0px; }

input, select, textarea { width: 100%; background: rgba(255, 255, 255, 0.533); color: var(--tx); border: 1px solid var(--sa); border-radius: 10px; padding: 10px; font: inherit; margin-top: 3px; }

.yt { background: var(--te); color: rgb(255, 255, 255); padding: 6px 10px; font-size: 12px; white-space: nowrap; }

.pt { position: relative; padding-left: 44px; margin-top: 10px; }

.pt::before { content: ""; position: absolute; left: 15px; top: 10px; bottom: 10px; width: 3px; background: var(--sa); border-radius: 2px; }

.nd { position: relative; display: flex; align-items: center; gap: 8px; margin: 10px 0px; }

.ci { position: absolute; left: -44px; width: 32px; height: 32px; border-radius: 50%; border: 3px solid var(--ol); background: var(--bg); color: var(--tx); padding: 0px; font-size: 15px; display: flex; align-items: center; justify-content: center; }

.nd.s1 .ci { background: var(--sa); }

.nd.s2 .ci { background: var(--ol); color: rgb(255, 255, 255); box-shadow: 0 0 0 4px color-mix(in srgb,var(--c) 55%,transparent); }

.nb { flex: 1 1 0%; cursor: pointer; }

.nm { font-weight: 600; }

.vb { color: var(--ol); font-weight: 700; }

.lv { background: var(--pe); border-radius: 16px; padding: 14px; margin-bottom: 12px; border-left: 5px solid var(--c); }

.op { display: flex; gap: 8px; align-items: center; padding: 8px; background: rgba(255, 255, 255, 0.4); border-radius: 10px; margin: 6px 0px; }

.op input { width: auto; margin: 0px; }
